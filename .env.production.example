# Copy to .env.production. Use a new immutable tag for each release.
RELEASE_TAG=initial
PUBLIC_APP_URL=https://zelo.example.com
# Generate distinct passwords: openssl rand -hex 32 (hex is URI-safe).
MONGO_ROOT_PASSWORD=REPLACE_ROOT_PASSWORD
MONGO_APP_PASSWORD=REPLACE_APP_PASSWORD
SMTP_URL=smtps://username:password@smtp.example.com:465
MAIL_FROM="Zelo <nao-responda@example.com>"
VAPID_PUBLIC_KEY=REPLACE_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@example.com
# For reproducibility, set tested image tags or sha256 digests before deployment.
MONGO_IMAGE=mongo:8.2
NGINX_IMAGE=nginx:stable-alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
