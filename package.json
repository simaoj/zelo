{
  "name": "zelo",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @zelo/api dev",
    "dev:worker": "pnpm --filter @zelo/api dev:worker",
    "dev:web": "pnpm --filter @zelo/web dev"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
