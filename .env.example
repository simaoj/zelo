# Copy to .env (docker compose reads it). Never commit real secrets.
NODE_ENV=production
# Public origin the browser uses (web app). Used for CSRF/Origin checks and reset links.
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated allowlist if web and API are served from different origins (leave empty for same-origin proxy)
CORS_ALLOWED_ORIGINS=
# Set to true behind HTTPS so cookies get the Secure flag
COOKIE_SECURE=false
# Local development outside Docker: mongodb://localhost:27017/zelo?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb://mongo:27017/zelo?replicaSet=rs0
SMTP_URL=smtp://mailpit:1025
MAIL_FROM="Zelo <nao-responda@zelo.local>"
# Web Push (generate with: pnpm --filter @zelo/api exec web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@zelo.local
LOG_LEVEL=info

# Host ports (change if already in use on your machine)
WEB_PORT=3000
API_PORT=4000
