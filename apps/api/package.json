{
  "name": "@zelo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bootstrap/main.ts",
    "dev:worker": "tsx watch src/bootstrap/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bootstrap/main.js",
    "start:worker": "node dist/bootstrap/worker.js",
    "db:migrate": "tsx src/bootstrap/migrate.ts",
    "db:seed": "tsx src/bootstrap/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@zelo/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "mongodb": "7.7.0",
    "nodemailer": "^10.1.2",
    "pino": "^10.4.0",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.5"
  }
}
